    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
