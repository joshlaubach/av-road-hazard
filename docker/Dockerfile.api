# Image for the API: CPU by default, CUDA 12.8 with docker/compose.gpu.yml.
FROM python:3.15-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock

# Real models: build with --build-arg WITH_ML=1 (docker/compose.real.yml does). CPU wheels of exactly the
# versions the weights were checked with; only what the API imports at run time, not the training extras.
ARG WITH_ML=0
# CPU wheels by default; docker/compose.gpu.yml passes the CUDA 12.8 index (the wheels carry their own CUDA
# libraries, so the base image stays python:3.12-slim and only the host driver is needed).
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
RUN if [ "$WITH_ML" = "1" ]; then \
      pip install --no-cache-dir \
        --index-url $TORCH_INDEX_URL --extra-index-url https://pypi.org/simple \
        torch==2.11.0 torchvision==0.26.0 timm==1.0.30 safetensors==0.8.0 \
        segmentation-models-pytorch==0.5.0 open_clip_torch==3.3.0; \
    fi

COPY pyproject.toml README.md LICENSE ./
COPY common ./common
COPY perception ./perception
COPY defects ./defects
COPY fusion ./fusion
COPY rag ./rag
COPY api ./api
COPY eval ./eval
COPY tools ./tools
COPY configs ./configs
# Editable install keeps source in /app so configs/ resolves relative to the package root.
RUN pip install --no-cache-dir --no-deps -e .

# Data, weights, and datasets are mounted as volumes, never baked in.
USER nobody
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
  CMD python -c "import urllib.request as u; u.urlopen('http://localhost:8000/health', timeout=2)"
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
