# Purpose: keep data, weights, secrets, caches and build output out of git for av-road-hazard.
# F:L-08 data/MANIFEST.json and checkpoints/MANIFEST.json stay tracked (versions and SHA-256 hashes); the files they describe do not.

# Data, weights, outputs
data/*
!data/MANIFEST.json
# Recommendation, not a decision: SPEC section 4 says data/ holds download scripts, so keep them tracked. See docs/OPEN_QUESTIONS.md.
!data/*.py
!data/*.md
checkpoints/*
!checkpoints/MANIFEST.json
outputs/
runs/
debug_dump/
qdrant_storage/
*.pt
*.pth
*.ckpt

# Secrets
.env
!.env.example

# Experiment tracking
wandb/
mlruns/
lightning_logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Node
node_modules/
.next/
out/
npm-debug.log*

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp

# graphify knowledge-graph output (local, regenerable)
/graphify-out/

# Scratch notebooks (outputs can embed nuScenes images; keep local). Only the eval notebooks are
# tracked, with outputs cleared (tests/notebooks/test_eval_notebooks.py enforces it).
notebooks/*
!notebooks/0[34]_eval_*.ipynb

# Git worktrees that Claude Code creates for parallel agents (local, disposable)
.claude/worktrees/

# Local-only folders that sit in the repository root: a second checkout (wt-gap), the hand-off
# bundle, tool notes and logs, and screenshots from checking the web UI. runs/ is above.
/wt-gap/
/handoff/
/.vibe-wise/
/.playwright-mcp/
/scratch_*.png
