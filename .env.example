# Purpose: names of environment variables for av-road-hazard. Names and defaults only; never put real values here.
# F:E-12 local services: Ollama on http://localhost:11434 with llama3.2-vision; Qdrant in Docker locally, Qdrant Cloud free tier when hosted.
# F:E-07 datasets are never baked into images; mount volumes and set paths here.
# Copy to .env (gitignored) and fill in. Secrets go only in .env or the hosting platform's secret store.

# Dataset locations (local machine only; nuScenes images never leave it)
NUSCENES_ROOT=
RDD2022_ROOT=

# LLM backend: ollama or claude
LLM_BACKEND=ollama

# Claude API (billed separately from the Claude subscription); key from env only
ANTHROPIC_API_KEY=
# Hard monthly cutoff in USD; the app shows a fallback message when reached
ANTHROPIC_MONTHLY_SPEND_CAP_USD=

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# Qdrant (local Docker or Qdrant Cloud free tier)
QDRANT_URL=
QDRANT_API_KEY=

# 1 = perception.infer.detect() and defects.infer.find_defects() return fixed fake outputs
USE_STUBS=

# Directory for pipeline intermediates (road mask, tiles, boxes, detections, fused record)
DEBUG_DUMP_DIR=

LOG_LEVEL=

# Weights and data directories (not in git)
CHECKPOINT_DIR=
DATA_DIR=
